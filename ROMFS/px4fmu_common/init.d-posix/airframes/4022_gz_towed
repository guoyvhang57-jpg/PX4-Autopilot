#!/bin/sh
#
# @name Gazebo towed (quad lift + 2 thrust motors)
#
# @type Quadrotor
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=towed}

param set-default SIM_GZ_EN 1

# ---------------------------------------------------------------------------
# 6 个电机全部进控制分配器：
#   0-3 升力旋翼（推力轴朝上）
#   4-5 推力电机（+70° 倾角：前 0.940 / 上 0.342）
# 拖曳模式下 [升力, 前推力] -> [升力桨, 推力桨] 的分配由 towed_control 模块决定，
# 模块发 vehicle_attitude_setpoint{q_d, thrust_body} 给 PX4
# ---------------------------------------------------------------------------
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 6

# 几何：model.sdf 是 FLU(y左正)，CA_ROTORn_PX/PY/PZ 用 FRD(y右正, z下正) => PY = -SDF_y
# --- 升力旋翼 ---
param set-default CA_ROTOR0_PX  0.29898    # 右前 ccw
param set-default CA_ROTOR0_PY  0.33634
param set-default CA_ROTOR0_KM  0.025
param set-default CA_ROTOR1_PX -0.29898    # 左后 ccw
param set-default CA_ROTOR1_PY -0.33634
param set-default CA_ROTOR1_KM  0.025
param set-default CA_ROTOR2_PX  0.29898    # 左前 cw
param set-default CA_ROTOR2_PY -0.33634
param set-default CA_ROTOR2_KM -0.025
param set-default CA_ROTOR3_PX -0.29898    # 右后 cw
param set-default CA_ROTOR3_PY  0.33634
param set-default CA_ROTOR3_KM -0.025

# --- 推力电机 ---
# 推力轴 = link 局部 +z 在机体系(FRD)的分量
# PZ = -0.283 ：推力线在重心上方 0.283 m，分配器据此自动配平抬头力矩 (0.283*Fx)
# PY = 0      ：故意不告诉它力臂 —— 否则分配器会优先用它们做偏航（力臂 0.517 vs
#               升力桨 KM 0.025），造成持续差动、白耗功率，并在机翼上产生非指令滑流。
#               以后若要用差动偏航，把 PY 改成 ±0.55
param set-default CA_ROTOR4_PX  0
param set-default CA_ROTOR4_PY  0
param set-default CA_ROTOR4_PZ -0.283
param set-default CA_ROTOR4_AX  0.940
param set-default CA_ROTOR4_AY  0
param set-default CA_ROTOR4_AZ -0.342
param set-default CA_ROTOR4_KM  0
param set-default CA_ROTOR5_PX  0
param set-default CA_ROTOR5_PY  0
param set-default CA_ROTOR5_PZ -0.283
param set-default CA_ROTOR5_AX  0.940
param set-default CA_ROTOR5_AY  0
param set-default CA_ROTOR5_AZ -0.342
param set-default CA_ROTOR5_KM  0

# ---------------------------------------------------------------------------
# 让 thrust_body 的单位正好是牛顿（三个参数必须配套）：
#   CA_ROTORn_CT   = 每桨满推推力 [N]（分配器里 CT 是线性系数）
#   SIM_GZ_EC_MINn = 0                （无怠速偏置，物理推力 = CT * u^2）
#   THR_MDL_FAC    = 1.0              （输出级把"推力指令"开方成电机指令，正好抵消
#                                       T ∝ w^2，使分配器的线性模型精确）
# ---------------------------------------------------------------------------
param set-default CA_ROTOR0_CT 21.6
param set-default CA_ROTOR1_CT 21.6
param set-default CA_ROTOR2_CT 21.6
param set-default CA_ROTOR3_CT 21.6
param set-default CA_ROTOR4_CT 21.6
param set-default CA_ROTOR5_CT 21.6
param set-default THR_MDL_FAC 1.0

# 电调映射：单位是 rad/s，必须等于对应插件的 maxRotVelocity
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_MIN1 0
param set-default SIM_GZ_EC_MAX1 520
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_MIN2 0
param set-default SIM_GZ_EC_MAX2 520
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_MIN3 0
param set-default SIM_GZ_EC_MAX3 520
param set-default SIM_GZ_EC_FUNC4 104
param set-default SIM_GZ_EC_MIN4 0
param set-default SIM_GZ_EC_MAX4 520
param set-default SIM_GZ_EC_FUNC5 105
param set-default SIM_GZ_EC_MIN5 0
param set-default SIM_GZ_EC_MAX5 520
param set-default SIM_GZ_EC_FUNC6 106
param set-default SIM_GZ_EC_MIN6 0
param set-default SIM_GZ_EC_MAX6 520

# 该机没有空速管（只有 rc.vtol_defaults / rc.fw_defaults 会要求空速）
param set-default SYS_HAS_NUM_ASPD 0

# 悬停油门：4 个升力桨扛 4.087 kg -> 40.1 N / (4 * 21.6) = 0.46
param set-default MPC_THR_HOVER 0.46
param set-default MC_AIRMODE 1
param set-default NAV_DLL_ACT 2

# ---------------------------------------------------------------------------
# 解锁方式：遥控器手势（不用解锁开关）
#   手势 = 左杆油门最低 + 左杆偏航打满右 + 右杆回中，保持 1 s
#   退锁 = 左杆油门最低 + 左杆偏航打满左 + 右杆回中，保持 1 s
#   ⚠ 要回中的只有**右杆**：油门不能回中，判定是 throttle < -0.8
#     （最低 = -1、中位 = 0），回中位就判不出来，必须一直压到底。
#     虚拟摇杆的油门轴是自回中的 -> 要用手按住，松手弹回 = 手势没做完。
#
#   RC_MAP_ARM_SW = 0       配了解锁开关的话，manual_control 会把
#                           MAN_ARM_GESTURE 自动改成 0，手势就没了
#   MAN_ARM_GESTURE = 1     手势总开关
#   MAN_OVERRIDE_SPD < 0    关掉"摇杆接管"。否则解锁后把偏航杆回中会被判成
#                           sticks_moving，commander 立刻切到 Position 模式 ->
#                           掉出 Offboard -> my_mission 中止。
#                           （v1.18 去掉了 v1.17 的 COM_RC_OVERRIDE，改成这个
#                             不分模式的摇杆速度阈值）
#   MC_AIRMODE != 2         偏航 airmode 也会禁用手势；本机是 1
#
#   SITL 没有真遥控器：用 QGC -> 应用设置 -> 虚拟摇杆(Virtual Joystick)，
#   它会以 MAVLink MANUAL_CONTROL 喂 manual_control_setpoint，
#   手势判定走的是同一份 setpoint，所以照样能解锁。
#   （COM_RC_IN_MODE 默认 3 = RC 或 MAVLink 保留第一个，不用改。）
#
#   ⚠ 上面的 NAV_DLL_ACT = 2 额外要求"必须有地面站连接才能解锁"。用 QGC 虚拟
#     摇杆时地面站是连着的，所以没问题；直接敲 commander arm 而没连 QGC 会报
#     "Preflight Fail: No connection to the GCS"，那时把 NAV_DLL_ACT 设 0。
# ---------------------------------------------------------------------------
param set-default RC_MAP_ARM_SW 0
param set-default MAN_ARM_GESTURE 1
param set-default MAN_OVERRIDE_SPD -1

# 拖曳模式控制器：自动启动已关闭。
#   towed_control 和 my_mission 都会发 offboard_control_mode，而它是单实例 topic，
#   两个同时跑会互抢（commander 只认最后写的那个）。需要拖曳测试时手动
#   `towed_control start`，或把下面这行取消注释。
# towed_control start

# Offboard 位置任务：起飞 1 m -> 向前飞 3 m -> 悬停 5 s -> 降落 -> 上锁
#   飞手操作顺序（my_mission 自己不 arm、也不自己切模式）：
#     1) 模式开关（或 commander mode offboard）切到 Offboard，COM_FLTMODE<n> = 7
#        此时还没解锁是正常的：本模块从 start 起就一直发 offboard_control_mode，
#        commander 允许在"未解锁"状态下就切进 Offboard。
#        （反过来先解锁再切 Offboard 也能跑，但切进去那一刻就会起飞，
#          所以推荐先模式后解锁。）
#     2) 遥控器手势解锁（虚拟摇杆：油门最低 + 偏航打满右，保持 1 s）
#     3) 模块检测到 (armed && offboard && 位置有效)
#        -> 自动起飞 -> 向前飞 -> 悬停 -> 降落 -> 上锁
my_mission start
